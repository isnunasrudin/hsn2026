generator sqliteImportClient {
  provider = "prisma-client"
  output   = "../server/generated/sqlite-import"
}

datasource db {
  provider = "sqlite"
}

model LegacyUser {
  id           Int     @id
  name         String
  email        String
  passwordHash String  @map("password_hash")
  role         String
  isActive     Int     @map("is_active")
  lastLoginAt  BigInt? @map("last_login_at")
  createdAt    BigInt  @map("created_at")
  updatedAt    BigInt  @map("updated_at")

  @@map("users")
}

model LegacyActivity {
  id                    Int     @id
  type                  String
  title                 String
  organizer             String?
  slug                  String
  description           String?
  juknisFileName        String? @map("juknis_file_name")
  juknisStorageName     String? @map("juknis_storage_name")
  juknisMimeType        String? @map("juknis_mime_type")
  juknisSize            Int?    @map("juknis_size")
  image                 String?
  imageZoom             Float   @map("image_zoom")
  imagePosition         String  @map("image_position")
  displayOrder          Int     @map("display_order")
  location              String?
  startsAt              BigInt  @map("starts_at")
  endsAt                BigInt? @map("ends_at")
  registrationOpensAt   BigInt  @map("registration_opens_at")
  registrationClosesAt  BigInt  @map("registration_closes_at")
  registrationMode      String  @map("registration_mode")
  quotaMode             String  @map("quota_mode")
  capacity              Int?
  minTeamMembers        Int?    @map("min_team_members")
  maxTeamMembers        Int?    @map("max_team_members")
  registrationFields    String  @map("registration_fields")
  status                String
  createdBy             Int     @map("created_by")
  createdAt             BigInt  @map("created_at")
  updatedAt             BigInt  @map("updated_at")

  @@map("activities")
}

model LegacyActivityUser {
  activityId Int    @map("activity_id")
  userId     Int    @map("user_id")
  createdAt  BigInt @map("created_at")

  @@id([activityId, userId])
  @@map("activity_users")
}

model LegacyRegistration {
  id               Int     @id
  code             String
  activityId       Int     @map("activity_id")
  registrantName   String  @map("registrant_name")
  email            String
  phone            String
  institution      String?
  teamName         String? @map("team_name")
  participantCount Int     @map("participant_count")
  answers          String
  status           String
  operatorNotes    String? @map("operator_notes")
  verifiedBy       Int?    @map("verified_by")
  verifiedAt       BigInt? @map("verified_at")
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  @@map("registrations")
}

model LegacyRegistrationMember {
  id             Int     @id
  registrationId Int     @map("registration_id")
  name           String
  identityNumber String? @map("identity_number")
  metadata       String

  @@map("registration_members")
}

model LegacyLoginAttempt {
  id          Int    @id
  email       String
  ipAddress   String @map("ip_address")
  attemptedAt BigInt @map("attempted_at")

  @@map("login_attempts")
}
